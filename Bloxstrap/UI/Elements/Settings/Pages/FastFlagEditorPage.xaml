<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.FastFlagEditorPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="FastFlags" Scrollable="True" Loaded="Page_Loaded">
 <StackPanel Margin="0,0,14,14">
  <TextBlock Text="FastFlags" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12" />
  <TextBlock TextWrapping="Wrap" Text="View, search and edit ClientAppSettings.json. Roblox only applies locally allowlisted flags. Imports preserve names, casing and scalar values exactly, including shortened names and place/datacenter filters. No online flag catalog is required. Competitive may override its managed rendering flags while a game is running. Save changes before launching." Margin="0,0,0,14" />
  <WrapPanel Margin="0,0,0,12">
   <ui:Button Content="Add / paste JSON" Click="Add_Click" Padding="12,6" Margin="0,0,8,8" />
   <ui:Button Content="Import file" Click="Import_Click" Padding="12,6" Margin="0,0,8,8" />
   <ui:Button Content="Export JSON" Click="Export_Click" Padding="12,6" Margin="0,0,8,8" />
   <ui:Button Content="Copy JSON" Click="Copy_Click" Padding="12,6" Margin="0,0,8,8" />
   <ui:Button Content="Delete selected" Click="Delete_Click" Padding="12,6" Margin="0,0,8,8" />
   <ui:Button Content="Clear all" Click="Clear_Click" Padding="12,6" Margin="0,0,8,8" />
   <ui:Button Content="Undo" Click="Undo_Click" Padding="12,6" Margin="0,0,8,8" />
   <ui:Button Content="Redo" Click="Redo_Click" Padding="12,6" Margin="0,0,8,8" />
  </WrapPanel>
  <TextBox x:Name="SearchBox" TextChanged="Search_Changed" Padding="10,6" Margin="0,0,0,10" ToolTip="Search flag names or values" />
  <DataGrid x:Name="FlagGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" MinHeight="300" MaxHeight="470" CellEditEnding="Cell_EditEnding" Background="{DynamicResource BrandNavigationBackground}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
    <DataGridTextColumn Header="Value (double-click to edit)" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="240" />
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock x:Name="CountLabel" Margin="0,10,0,0" TextWrapping="Wrap" />
 </StackPanel>
</ui:UiPage>
