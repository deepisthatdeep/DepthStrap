<base:WpfUiWindow x:Class="Bloxstrap.UI.Elements.Settings.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:Bloxstrap.UI.Elements.Settings.Pages"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
             xmlns:resources="clr-namespace:Bloxstrap.Resources"
             xmlns:dmodels="clr-namespace:Bloxstrap.UI.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance dmodels:MainWindowViewModel, IsDesignTimeCreatable=True}"
             Title="DepthStrap"
             MinWidth="960"
             Width="1280"
             MinHeight="600"
             Height="800"
             Background="{ui:ThemeResource ApplicationBackgroundBrush}"
             ExtendsContentIntoTitleBar="True"
            WindowBackdropType="None"
             WindowStartupLocation="CenterScreen"
             Closing="WpfUiWindow_Closing"
             Closed="WpfUiWindow_Closed">

    <Grid Background="{DynamicResource ApplicationBackground}" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:Snackbar
            x:Name="AlreadyRunningSnackbar"
            Title="{x:Static resources:Strings.Menu_AlreadyRunning_Title}"
            Message="{x:Static resources:Strings.Menu_AlreadyRunning_Caption}"
            Background="{DynamicResource ShellSurfaceBrush}" Icon="Info20" Timeout="5000" MaxWidth="600" Margin="24,0,24,88" Grid.RowSpan="3" Panel.ZIndex="10" />

        <ui:Snackbar
            x:Name="SettingsSavedSnackbar"
            Title="{x:Static resources:Strings.Menu_SettingsSaved_Title}"
            Message="{x:Static resources:Strings.Menu_SettingsSaved_Message}"
            Background="{DynamicResource ShellSurfaceBrush}" Icon="CheckmarkCircle24" Timeout="3000" MaxWidth="600" Margin="24,0,24,88" Grid.RowSpan="3" Panel.ZIndex="9" />

        <ui:TitleBar Padding="8" x:Name="RootTitleBar" Grid.Row="0" ForceShutdown="False" MinimizeToTray="False" UseSnapLayout="True" Title="DepthStrap" Icon="pack://application:,,,/DepthStrap.ico" />

        <Grid x:Name="RootGrid" Grid.Row="1" Margin="16,8,16,16" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="HeroSurface" Grid.Row="0" Grid.ColumnSpan="2" Height="112" Margin="0,0,0,16" CornerRadius="14"
                    Background="{DynamicResource BrandHeroBackground}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1">
                <Grid Margin="24,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource ShellSurfaceBrush}" Padding="14,8" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="DepthStrap" FontSize="32" FontWeight="SemiBold" />
                        <TextBlock Text="Roblox for Windows" Margin="0,6,0,0" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    </Border>
                    <Image Grid.Column="1" Source="pack://application:,,,/DepthStrap;component/Resources/Brand/DepthStrap.png" Width="64" Height="64" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
            </Border>

            <Border x:Name="NavigationSurface" Grid.Row="1" Grid.Column="0" Margin="0,0,16,0" Padding="10,12"
                    CornerRadius="14" Background="{DynamicResource ShellSurfaceBrush}"
                    BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1">
            <ui:NavigationCompact x:Name="RootNavigation" Frame="{Binding ElementName=RootFrame}" IsExpanded="{Binding IsSidebarExpanded, Mode=TwoWay}" MaxWidth="220" SelectedPageIndex="0" FooterAlwaysVisible="True">
                <ui:NavigationCompact.Items>
                    <!-- merged page: Competitive Mode + Roblox Global Settings (GBS) -->
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_RobloxSettings_Title}" PageType="{x:Type pages:CompetitivePage}" Icon="SquareHintApps24" IconSize="20" Tag="robloxsettings" x:Name="robloxsettings" />
                    <!-- renamed from Region Selector; page internals unchanged -->
                    <ui:NavigationItem Content="FastFlags" PageType="{x:Type pages:FastFlagEditorPage}" Icon="Code24" IconSize="20" Tag="fastflags" />
                    <ui:NavigationItem Content="ID Selector" PageType="{x:Type pages:RegionSelectorPage}" Icon="Earth24" IconSize="20" Tag="regionselector" />
                    <!-- Roblox launch behavior (split from old Bootstrapper/Behaviour page) -->
                    <ui:NavigationItem Content="Roblox Launch" PageType="{x:Type pages:AdvancedRobloxSettingsPage}" Icon="PlaySettings20" IconSize="20" Tag="advancedroblox" />
                    <!-- app-level settings (channel, static dir, cleaner, dialog customization) -->
                    <ui:NavigationItem Content="DepthStrap" PageType="{x:Type pages:DepthStrapSettingsPage}" Icon="Settings20" IconSize="20" Tag="depthstrapsettings" />
                    <ui:NavigationItem Content="Anti Api ( Beta )" PageType="{x:Type pages:AntiApiPage}" Icon="Toolbox24" IconSize="20" Tag="antiapi" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Appearance_Title}" PageType="{x:Type pages:AppearancePage}" Icon="PaintBrush24" IconSize="20" Tag="appearance" />
                </ui:NavigationCompact.Items>
                <!-- About removed from navigation (window code kept dormant; OpenAboutCommand still available) -->
            </ui:NavigationCompact>
            </Border>

            <Border x:Name="ContentSurface" Grid.Row="1" Grid.Column="1" CornerRadius="14"
                    Background="{DynamicResource ShellSurfaceBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1">
            <Grid Margin="20,16,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ui:InfoBar x:Name="AlertBar" Grid.Row="0" Margin="0,0,12,12" Padding="8" Visibility="Collapsed" IsOpen="True" Message="" Severity="Warning" IsClosable="False" />
                <Border Grid.Row="1" Margin="0,0,12,14" Padding="0,0,0,14" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ShellBorderBrush}">
                    <ui:Breadcrumb Current="{x:Static resources:Strings.Menu_RobloxSettings_Title}" Navigation="{Binding ElementName=RootNavigation}" />
                </Border>
                <Frame x:Name="RootFrame" Grid.Row="2" NavigationUIVisibility="Hidden" />
            </Grid>
            </Border>
        </Grid>

        <Border x:Name="RootStatusBar" Grid.Row="2" Padding="20,12" Background="{DynamicResource ShellSurfaceBrush}"
                BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Test Mode -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <ui:ToggleSwitch IsChecked="{Binding TestModeEnabled, Mode=TwoWay}" Height="22"
                                     VerticalAlignment="Center" AutomationProperties.Name="{x:Static resources:Strings.Menu_TestMode}" />
                    <TextBlock Text="{x:Static resources:Strings.Menu_TestMode}" FontSize="13"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Close -->
                    <ui:Button x:Name="CloseButton" Content="{x:Static resources:Strings.Common_Close}"
                               MinHeight="36" Padding="16,6" Margin="0,2,8,2" Command="{Binding CloseWindowCommand}" />
                    <!-- Restart -->
                    <ui:Button x:Name="RestartButton" Content="{x:Static resources:Strings.Menu_Restart}"
                               MinHeight="36" Padding="16,6" Margin="0,2,8,2" Command="{Binding RestartAppCommand}" />
                    <!-- Save -->
                    <ui:Button x:Name="SaveButton" Content="{x:Static resources:Strings.Menu_Save}"
                               MinHeight="36" Padding="16,6" Margin="0,2,12,2" Command="{Binding SaveSettingsCommand}" />
                    <!-- Save & Launch -->
                    <ui:Button x:Name="LaunchButton" Content="{x:Static resources:Strings.Menu_SaveAndLaunch}"
                               Appearance="Primary" MinHeight="36" Padding="20,6" Margin="0,2,0,2"
                               FontWeight="SemiBold" Click="LaunchButton_Click">
                        <ui:Button.ContextMenu>
                            <ContextMenu x:Name="LaunchMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Launch Roblox Player" Command="{Binding SaveAndLaunchPlayerCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Games24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Launch Roblox Studio" Command="{Binding SaveAndLaunchStudioCommand}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="TextBulletListSquareToolbox20" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>
                </WrapPanel>
            </Grid>
        </Border>
        <Grid x:Name="LoadingOverlay"
            Visibility="Collapsed"
            Background="#A0000000"
            Panel.ZIndex="9999"
            Grid.Row="1"
            Grid.RowSpan="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="{DynamicResource ShellSurfaceBrush}"
                    CornerRadius="16"
                    Padding="32"
                    Effect="{DynamicResource ControlShadow}">
                    <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical">

                        <!-- Loading Text -->
                        <TextBlock x:Name="LoadingOverlayText"
                           Text="Loading..."
                           FontSize="20" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="480"
                           FontWeight="SemiBold"
                           Margin="0,0,0,20"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <ui:ProgressRing
                            IsIndeterminate="True"
                            Width="60"
                            Height="60"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,10,0,0" />

                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</base:WpfUiWindow>
