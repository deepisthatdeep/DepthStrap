<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.DepthStrapSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:Bloxstrap.UI.Elements.Settings.Pages"
      xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
      xmlns:models="clr-namespace:Bloxstrap.UI.ViewModels.Settings"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      d:DataContext="{d:DesignInstance Type=models:DepthStrapSettingsViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="800"
      Title="DepthStrapSettingsPage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <TextBlock Margin="0,0,0,8" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"
                   Text="DepthStrap app settings: updates, channel, static directory, file cleaner and bootstrapper dialog customization." />

        <!-- ============ DEPTHSTRAP (channel / updates / static dir) ============ -->
        <TextBlock Text="DepthStrap" FontSize="20" FontWeight="Bold" Margin="0,16,0,0" />

        <StackPanel DataContext="{Binding Channel}">
            <controls:OptionControl Header="Automatic DepthStrap updates" Description="Install verified stable GitHub releases when DepthStrap opens. Updates wait until Roblox and Studio are closed. Your settings are kept. Only DepthStrap updates; Roblox update settings stay unchanged.">
                <ui:ToggleSwitch IsChecked="{Binding AutomaticDepthStrapUpdates, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl Header="Save And Launch Action" Description="Adds an option so whenever clicking save and launch, it will ask if to studio or player.">
                <ui:ToggleSwitch IsChecked="{Binding SaveAndLaunchToPlayer, Mode=TwoWay}" />
            </controls:OptionControl>

            <Separator Margin="0,8,0,6"/>

            <TextBlock Text="Roblox" FontSize="20" FontWeight="Bold"/>

            <controls:OptionControl 
                Header="{x:Static resources:Strings.Menu_Behaviour_ForceRobloxReinstall_Title}"
                Description="{x:Static resources:Strings.Menu_Behaviour_ForceRobloxReinstall_Description}">
                <controls:OptionControl.Style>
                    <Style TargetType="controls:OptionControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRobloxInstallationMissing, Mode=OneTime}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:OptionControl.Style>
                <ui:ToggleSwitch IsChecked="{Binding ForceRobloxReinstallation, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl 
                Header="{x:Static resources:Strings.Menu_Channel_StaticDirectory_Title}"
                Description="{x:Static resources:Strings.Menu_Channel_StaticDirectory_Description}">
                <ui:ToggleSwitch IsChecked="{Binding StaticDirectory, Mode=TwoWay}" />
            </controls:OptionControl>

            <ui:CardExpander Margin="0,8,0,0" IsExpanded="True">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="14" Text="{x:Static resources:Strings.Common_Channel}" />
                        <TextBlock Margin="0,2,0,0" FontSize="12" Text="{x:Static resources:Strings.Menu_ChannelChanger_Description}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"  />
                    </StackPanel>
                    <ui:TextBox Grid.Column="1" Grid.Row="0" Margin="8,0,8,0" Padding="10,5,10,5" Width="200" Text="{Binding ViewChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                </Grid>
            </ui:CardExpander.Header>

            <StackPanel>
                <Grid Margin="0,0,4,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ChannelDeployInfo}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,16,8" VerticalAlignment="Center" Text="{x:Static resources:Strings.Common_Version}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ChannelDeployInfo.Version, Mode=OneWay}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,16,8" VerticalAlignment="Center" Text="{x:Static resources:Strings.Common_VersionGuid}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ChannelDeployInfo.VersionGuid, Mode=OneWay}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,16,8" VerticalAlignment="Center" Text="{x:Static resources:Strings.Common_Timestamp}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding ChannelDeployInfo.Timestamp, Mode=OneWay}" />

                    <Button Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" Content="{x:Static resources:Strings.Menu_ChannelChanger_AvailableChannels}" Click="OpenChannelListDialog_Click" />

                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowChannelWarning, Mode=OneWay}" Value="True">
                                        <Setter Property="StackPanel.Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Image Grid.Column="0" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Resources/MessageBox/Warning.png" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{x:Static resources:Strings.Menu_Deployment_Channel_OutOfDate}" />
                    </StackPanel>
                </Grid>

                <Grid Column="0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ChannelDeployInfo}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:ProgressRing Grid.Column="0" Margin="6" IsIndeterminate="True">
                        <ui:ProgressRing.Style>
                            <Style TargetType="ui:ProgressRing" BasedOn="{StaticResource {x:Type ui:ProgressRing}}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowLoadingError, Mode=OneWay}" Value="True">
                                        <Setter Property="ui:ProgressRing.Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:ProgressRing.Style>
                    </ui:ProgressRing>

                    <Image Grid.Column="0" Margin="6" Width="60" Height="60" Source="pack://application:,,,/Resources/MessageBox/Error.png">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowLoadingError, Mode=OneWay}" Value="True">
                                        <Setter Property="Image.Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <TextBlock Grid.Column="1" Margin="16" VerticalAlignment="Center" Text="{Binding ChannelInfoLoadingText, Mode=OneWay}" TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </ui:CardExpander>

            <controls:OptionControl 
                Header="{x:Static resources:Strings.Menu_Channel_ChangeAction_Title}" 
                Description="{x:Static resources:Strings.Menu_Channel_ChangeAction_Description}">
                <ComboBox Margin="5,0,0,0" Padding="10,5,10,5" Width="200" ItemsSource="{Binding ChannelChangeModes.Keys, Mode=OneTime}" Text="{Binding SelectedChannelChangeMode, Mode=TwoWay}" />
            </controls:OptionControl>
        </StackPanel>

        <!-- ============ CLEANER (from old Bootstrapper page) ============ -->
        <Separator Margin="0,16,0,8" />
        <TextBlock Text="Cleaner" FontSize="20" FontWeight="Bold" Margin="0,0,0,4" />

        <StackPanel DataContext="{Binding Cleaner}">
            <ui:CardExpander Grid.Row="1" Margin="0,8,0,0" IsExpanded="True">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_Bootstrapper_CleanUp_Title}" />
                            <TextBlock Margin="0,2,0,0" FontSize="12" Text="{x:Static resources:Strings.Menu_Bootstrapper_CleanUp_Description}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Grid>
                </ui:CardExpander.Header>

                <StackPanel>
                    <controls:OptionControl 
                        Header="{x:Static resources:Strings.Menu_Bootstrapper_Cleaner_Age_Title}" 
                        Description="{x:Static resources:Strings.Menu_Bootstrapper_Cleaner_Age_Description}">
                        <ComboBox Width="200" Padding="10,5,10,5" ItemsSource="{Binding CleanerOptions, Mode=OneTime}" Text="{Binding CleanerOption, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:OptionControl>
                    <controls:OptionControl 
                        Header="{x:Static resources:Strings.Menu_Bootstrapper_Cleaner_Cache_Title}" 
                        Description="{x:Static resources:Strings.Menu_Bootstrapper_Cleaner_Cache_Description}">
                        <ui:ToggleSwitch IsChecked="{Binding CleanerCache, Mode=TwoWay}" />
                    </controls:OptionControl>
                    <controls:OptionControl 
                        Header="{x:Static resources:Strings.Menu_Bootstrapper_Cleaner_Logs_Title}" 
                        Description="{x:Static resources:Strings.Menu_Bootstrapper_Cleaner_Logs_Description}">
                        <ui:ToggleSwitch IsChecked="{Binding CleanerLogs, Mode=TwoWay}" />
                    </controls:OptionControl>
                    <controls:OptionControl 
                        Header="{x:Static resources:Strings.Menu_Bootstrapper_Cleaner_IncludeBloxstrap_Title}"
                        Description="{x:Static resources:Strings.Menu_Bootstrapper_Cleaner_IncludeBloxstrap_Description}">
                        <ui:ToggleSwitch IsChecked="{Binding CleanerFroststrap, Mode=TwoWay}" />
                    </controls:OptionControl>
                </StackPanel>
            </ui:CardExpander>
        </StackPanel></StackPanel></ui:UiPage>
