<base:WpfUiWindow x:Class="Bloxstrap.UI.Elements.Settings.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:Bloxstrap.UI.Elements.Settings.Pages"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
             xmlns:resources="clr-namespace:Bloxstrap.Resources"
             xmlns:dmodels="clr-namespace:Bloxstrap.UI.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance dmodels:MainWindowViewModel, IsDesignTimeCreatable=True}"
             Title="{x:Static resources:Strings.Menu_Title}"
             MinWidth="250"
             Width="1280"
             MinHeight="250"
             Height="760"
             Background="{ui:ThemeResource ApplicationBackgroundBrush}"
             ExtendsContentIntoTitleBar="True"
            WindowBackdropType="None"
             WindowStartupLocation="CenterScreen"
             Closing="WpfUiWindow_Closing"
             Closed="WpfUiWindow_Closed">

    <Grid Background="{DynamicResource ApplicationBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:Snackbar
            x:Name="AlreadyRunningSnackbar"
            Title="{x:Static resources:Strings.Menu_AlreadyRunning_Title}"
            Message="{x:Static resources:Strings.Menu_AlreadyRunning_Caption}"
            Background="{DynamicResource NormalDarkAndLightBackground}" Icon="Info20" Timeout="5000" Margin="200,0,200,40" Grid.RowSpan="10" Panel.ZIndex="10" />

        <ui:Snackbar
            x:Name="SettingsSavedSnackbar"
            Title="{x:Static resources:Strings.Menu_SettingsSaved_Title}"
            Message="{x:Static resources:Strings.Menu_SettingsSaved_Message}"
            Background="#CC1A1A1A" Icon="CheckmarkCircle24" Timeout="3000" Margin="200,0,200,40" Grid.RowSpan="10" Panel.ZIndex="9" />

        <ui:TitleBar Padding="8" x:Name="RootTitleBar" Grid.Row="0" ForceShutdown="False" MinimizeToTray="False" UseSnapLayout="True" Title="{x:Static resources:Strings.Menu_Title}" Icon="pack://application:,,,/DepthStrap.ico" />

        <Grid x:Name="RootGrid" Grid.Row="1" Margin="10,8,0,0" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="1" Grid.Column="0" Margin="0,0,18,12" Padding="8,12" CornerRadius="12" Background="{DynamicResource BrandNavigationBackground}">
            <ui:NavigationCompact x:Name="RootNavigation" Frame="{Binding ElementName=RootFrame}" IsExpanded="{Binding IsSidebarExpanded, Mode=TwoWay}" Width="225" MaxWidth="225" SelectedPageIndex="0" FooterAlwaysVisible="True">
                <ui:NavigationCompact.Items>
                    <!-- merged page: Competitive Mode + Roblox Global Settings (GBS) -->
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_RobloxSettings_Title}" PageType="{x:Type pages:CompetitivePage}" Icon="SquareHintApps24" IconSize="20" Tag="robloxsettings" x:Name="robloxsettings" />
                    <!-- renamed from Region Selector; page internals unchanged -->
                    <ui:NavigationItem Content="FastFlags" PageType="{x:Type pages:FastFlagEditorPage}" Icon="Code24" IconSize="20" Tag="fastflags" />
                    <ui:NavigationItem Content="ID Selector" PageType="{x:Type pages:RegionSelectorPage}" Icon="Earth24" IconSize="20" Tag="regionselector" />
                    <!-- Roblox launch behavior (split from old Bootstrapper/Behaviour page) -->
                    <ui:NavigationItem Content="Roblox Launch" PageType="{x:Type pages:AdvancedRobloxSettingsPage}" Icon="PlaySettings20" IconSize="20" Tag="advancedroblox" />
                    <!-- app-level settings (channel, static dir, cleaner, dialog customization) -->
                    <ui:NavigationItem Content="DepthStrap Settings" PageType="{x:Type pages:DepthStrapSettingsPage}" Icon="Settings20" IconSize="20" Tag="depthstrapsettings" />
                    <ui:NavigationItem Content="Anti Api ( Beta )" PageType="{x:Type pages:AntiApiPage}" Icon="Toolbox24" IconSize="20" Tag="antiapi" />
                    <ui:NavigationItem Content="{x:Static resources:Strings.Menu_Appearance_Title}" PageType="{x:Type pages:AppearancePage}" Icon="PaintBrush24" IconSize="20" Tag="appearance" />
                </ui:NavigationCompact.Items>
                <!-- About removed from navigation (window code kept dormant; OpenAboutCommand still available) -->
            </ui:NavigationCompact>
            </Border>

            <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ui:InfoBar x:Name="AlertBar" Grid.Row="0" Margin="0,0,12,0" Padding="8" Visibility="Collapsed" IsOpen="True" Message="" Severity="Warning" IsClosable="False" />
                <ui:Breadcrumb Grid.Row="1" Margin="0,0,0,5" Navigation="{Binding ElementName=RootNavigation}" />
                <Frame x:Name="RootFrame" Grid.Row="2" />
            </Grid>
        </Grid>

        <StatusBar x:Name="RootStatusBar"
           Grid.Row="2"
           Padding="12,6"
           BorderThickness="0,1,0,0">

            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!-- Test Mode -->
            <StatusBarItem Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <ui:ToggleSwitch IsChecked="{Binding TestModeEnabled, Mode=TwoWay}" Height="22" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Static resources:Strings.Menu_TestMode}"
                       FontSize="13.5"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </StatusBarItem>

            <!-- Save & Launch -->
            <StatusBarItem Grid.Column="2" VerticalAlignment="Center" Margin="0,0,4,0">
                <ui:Button x:Name="LaunchButton"
               Content="{x:Static resources:Strings.Menu_SaveAndLaunch}"
               Appearance="Primary"
               Height="32"
               FontWeight="Medium"
               Padding="14,0"
               Click="LaunchButton_Click">
                    <ui:Button.ContextMenu>
                        <ContextMenu x:Name="LaunchMenu">
                            <MenuItem Header="Launch Roblox Player" Command="{Binding SaveAndLaunchPlayerCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Games24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Launch Roblox Studio" Command="{Binding SaveAndLaunchStudioCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="TextBulletListSquareToolbox20" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>
            </StatusBarItem>

            <!-- Restart -->
            <StatusBarItem Grid.Column="3" VerticalAlignment="Center" Margin="0,0,4,0">
                <ui:Button Content="{x:Static resources:Strings.Menu_Restart}"
               Height="32"
               Padding="14,0"
               FontWeight="Medium"
               Appearance="Primary"
               Command="{Binding RestartAppCommand}" />
            </StatusBarItem>

            <!-- Save -->
            <StatusBarItem Grid.Column="4" VerticalAlignment="Center" Margin="0,0,4,0">
                <ui:Button Content="{x:Static resources:Strings.Menu_Save}"
                   Appearance="Primary"
                   Height="32"
                   Padding="14,0"
                   FontWeight="Medium"
                   Command="{Binding SaveSettingsCommand}" />
            </StatusBarItem>

            <!-- Close -->
            <StatusBarItem Grid.Column="5" VerticalAlignment="Center" Margin="0,0,0,0">
                <ui:Button Content="{x:Static resources:Strings.Common_Close}"
                   Height="32"
                   Padding="14,0"
                   FontWeight="Medium"
                   Command="{Binding CloseWindowCommand}" />
            </StatusBarItem>
        </StatusBar>

        <Grid x:Name="LoadingOverlay"
            Visibility="Collapsed"
            Background="#A0000000"
            Panel.ZIndex="9999"
            Grid.Row="1"
            Grid.RowSpan="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="{DynamicResource NormalDarkAndLightBackground}"
                    CornerRadius="16"
                    Padding="32"
                    Effect="{DynamicResource ControlShadow}">
                    <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical">

                        <!-- Loading Text -->
                        <TextBlock x:Name="LoadingOverlayText"
                           Text="Loading..."
                           FontSize="22"
                           FontWeight="SemiBold"
                           Margin="0,0,0,20"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <ui:ProgressRing
                            IsIndeterminate="True"
                            Width="60"
                            Height="60"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,10,0,0" />

                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</base:WpfUiWindow>
