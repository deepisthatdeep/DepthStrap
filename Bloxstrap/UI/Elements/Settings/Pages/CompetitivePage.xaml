<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.CompetitivePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
      xmlns:models="clr-namespace:Bloxstrap.UI.ViewModels.Settings"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      d:DataContext="{d:DesignInstance Type=models:CompetitivePageViewModel}"
      mc:Ignorable="d"
      d:DesignHeight="1400" d:DesignWidth="800"
      Title="CompetitivePage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">
        <TextBlock
            Margin="0,0,0,8"
            FontSize="14"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Text="Roblox Settings: Competitive Mode (server region, CPU priority, rendering load, Chime diagnostics) plus Roblox global settings (graphics, audio, input). Measurable optimizations first - no placebo ping flags." />

        <!-- ============ COMPETITIVE MODE ============ -->
        <ui:CardExpander Margin="0,8,0,0" IsExpanded="True">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="14" Text="Competitive Mode" FontWeight="SemiBold" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Master switch. Disabling returns to ordinary DepthStrap behavior." />
                    </StackPanel>

                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled, Mode=TwoWay}" />
                </Grid>
            </ui:CardExpander.Header>

            <StackPanel Margin="0,8,0,0">
                <controls:OptionControl Header="Presets" Description="Competitive: High priority, quality 3, minimum supported mesh LOD and MSAA 1x. Balanced: moderate visuals. Both match monitor Hz and retain adaptive server selection and networking diagnostics.">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0" Content="Balanced" Padding="12,6" Command="{Binding ApplyBalancedPresetCommand}" />
                        <ui:Button Margin="0,0,8,0" Content="Competitive" Padding="12,6" Command="{Binding ApplyMaximumPresetCommand}" />
                        <ui:Button Content="Default Roblox" Padding="12,6" Command="{Binding ApplyDefaultRobloxPresetCommand}" />
                    </StackPanel>
                </controls:OptionControl>

                <controls:OptionControl Header="View Competitive Log" Description="Today's session log (priority verification, region evaluations). Created on next launch.">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0" Content="Open Log" Padding="12,6" Command="{Binding ViewCompetitiveLogCommand}" />
                        <ui:Button Content="Logs Folder" Padding="12,6" Command="{Binding OpenLogsFolderCommand}" />
                    </StackPanel>
                </controls:OptionControl>
            </StackPanel>
        </ui:CardExpander>

        <!-- ============ CURRENT SESSION (live) ============ -->
        <ui:CardExpander Margin="0,8,0,0" IsExpanded="True">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="14" Text="Current Session" FontWeight="SemiBold" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Updates while connected. Region and network details load after each server join." />
                    </StackPanel>

                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="{Binding SessionUpdated, StringFormat=updated {0}}" />
                </Grid>
            </ui:CardExpander.Header>

            <StackPanel Margin="0,8,0,0">
                <controls:OptionControl Header="Server / Region" Description="Resolved location + region preference quality (score is a preference score, not ping).">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding SessionLocation}" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding SessionQuality}" />
                    </StackPanel>
                </controls:OptionControl>

                <controls:OptionControl Header="Live endpoint (UDMUX)" Description="The UDMUX proxy IP the client actually connected to - the real measurement target. 'direct' means no UDMUX fronting.">
                    <TextBlock FontFamily="Consolas" VerticalAlignment="Center" Text="{Binding SessionUdmux}" />
                </controls:OptionControl>

                <controls:OptionControl Header="Join type" Description="public join / teleport / reserved (Chime candidate when both).">
                    <TextBlock VerticalAlignment="Center" Text="{Binding SessionTeleport}" />
                </controls:OptionControl>

                <controls:OptionControl Header="WARP / Cloudflare ingress" Description="What Cloudflare sees for this machine. Label is user input; this is the actual tunnel state.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="{Binding SessionWarp}" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding SessionColo, StringFormat=POP {0}}" />
                    </StackPanel>
                </controls:OptionControl>

                <controls:OptionControl Header="ICMP RTT" Description="Supplementary measurement against the live endpoint. 'no ICMP measurement' is normal - Roblox gameplay is UDP and may ignore echo.">
                    <TextBlock VerticalAlignment="Center" Text="{Binding SessionIcmp}" />
                </controls:OptionControl>

                <!-- advanced / debug details -->
                <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
                    <ui:CardExpander.Header>
                        <TextBlock FontSize="13" Text="Advanced / debug details" FontWeight="SemiBold" />
                    </ui:CardExpander.Header>

                    <StackPanel Margin="0,8,0,0">
                        <controls:OptionControl Header="Job ID">
                            <TextBlock FontFamily="Consolas" VerticalAlignment="Center" Text="{Binding SessionJobId}" />
                        </controls:OptionControl>
                        <controls:OptionControl Header="RCC address (real server behind UDMUX)">
                            <TextBlock FontFamily="Consolas" VerticalAlignment="Center" Text="{Binding SessionRccIp}" />
                        </controls:OptionControl>
                        <controls:OptionControl Header="Universe / Place ID">
                            <TextBlock FontFamily="Consolas" VerticalAlignment="Center" Text="{Binding SessionUniversePlace}" />
                        </controls:OptionControl>
                        <controls:OptionControl Header="Traceroute file" Description="Saved by the background tracert when enabled.">
                            <TextBox IsReadOnly="True" Padding="4,3" FontFamily="Consolas" FontSize="12"
                                     VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                     Text="{Binding SessionTraceFile, Mode=OneWay}" />
                        </controls:OptionControl>
                    </StackPanel>
                </ui:CardExpander>
            </StackPanel>
        </ui:CardExpander>

        <!-- ============ REGION ============ -->
        <ui:CardExpander Margin="0,8,0,0" IsExpanded="True">
            <ui:CardExpander.Header>
                <TextBlock FontSize="14" Text="Region" FontWeight="SemiBold" />
            </ui:CardExpander.Header>

            <StackPanel Margin="0,8,0,0">
                <controls:OptionControl Header="Learn regions automatically" Description="Runs during installation, then learns from usable server measurements by route and time of day. No city is preselected. ICMP is supplementary evidence, not gameplay ping.">
                    <ui:ToggleSwitch IsEnabled="{Binding IcmpAvailable}" IsChecked="{Binding AdaptiveRegions, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="Network comparison" Description="Disconnect other VPNs and proxies first. Compare normal routing against WARP after moving or changing your connection.">
                    <StackPanel Width="240">
                        <ui:Button Content="Compare normal / WARP" Command="{Binding RecalibrateRegionsCommand}" Padding="12,6" />
                        <TextBlock Text="{Binding CalibrationStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </controls:OptionControl>
                <controls:OptionControl Header="Preferred Region" Description="Measured during installation and refined as you play. Turn off learning to keep a manual preference. Leave empty for Roblox matchmaking.">
                    <TextBox IsEnabled="{Binding ManualRegionControls}" Width="160" Padding="6,3" Text="{Binding PreferredCity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls:OptionControl>

                <controls:OptionControl Header="Fallback Regions" Description="Filled from usable installation-test measurements, then refined as you play. One city per line, strongest fallback first.">
                    <TextBox
                        IsEnabled="{Binding ManualRegionControls}" Width="200" Height="90"
                        Padding="6,3"
                        AcceptsReturn="True"
                        TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Auto"
                        FontFamily="Consolas"
                        Text="{Binding FallbackCitiesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls:OptionControl>

                <controls:OptionControl Header="Prefer NA" Description="Automatically selected for North American players during setup. Changing this filter reranks measured regions.">
                    <ui:ToggleSwitch IsChecked="{Binding PreferNorthAmericaOnly, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="Prefer EU" Description="Automatically selected for European players during setup. Changing this filter reranks measured regions.">
                    <ui:ToggleSwitch IsChecked="{Binding PreferEuropeOnly, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="Scan Limits" Description="Bounded preferred-region scan in the Region Selector (pages / seconds). Stops early on an ideal match.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Max pages:" />
                        <TextBox Width="50" Margin="8,0,16,0" Padding="4,3" VerticalAlignment="Center" Text="{Binding MaxScanPages, Mode=TwoWay}" />
                        <TextBlock VerticalAlignment="Center" Text="Timeout (s):" />
                        <TextBox Width="50" Margin="8,0,0,0" Padding="4,3" VerticalAlignment="Center" Text="{Binding ScanTimeoutSeconds, Mode=TwoWay}" />
                    </StackPanel>
                </controls:OptionControl>

                <controls:OptionControl Header="Auto-select preferred server on Deepwoken launch" Description="Deepwoken launches without an explicit server ID get the best public server in your preferred region. Private servers and teleports are never touched." >
                    <ui:ToggleSwitch IsEnabled="{Binding IcmpAvailable}" IsChecked="{Binding AutoSelectPreferredServerOnLaunch, Mode=TwoWay}" />
                </controls:OptionControl>
            </StackPanel>
        </ui:CardExpander>

        <!-- ============ CHIME ============ -->
        <ui:CardExpander Margin="0,8,0,0" IsExpanded="True">
            <ui:CardExpander.Header>
                <TextBlock FontSize="14" Text="Deepwoken Chime Monitor" FontWeight="SemiBold" />
            </ui:CardExpander.Header>

            <StackPanel Margin="0,8,0,0">
                <controls:OptionControl Header="Monitor Chime teleports" Description="Detects Deepwoken (Universe 1359573625) reserved-server teleports via the Roblox log watcher. No injection, no packet hooks." >
                    <ui:ToggleSwitch IsChecked="{Binding ChimeMonitorEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="Warn on bad region" Description="Shows a popup for a known bad Deepwoken server or Chime region. Bad-region joins are logged even when alerts are disabled.">
                    <ui:ToggleSwitch IsChecked="{Binding WarnOnBadChimeRegion, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="Autolog and rejoin Deepwoken" Description="Leave a confirmed bad-region Deepwoken gameplay server, reopen Roblox Home, then rejoin after a cancelable 10-second countdown. Covers the Depths, Layer 2 and Chime. The entry menu, nearby unmeasured regions and unknown locations are retained. One recovery per 10 minutes; the recovered client shows warnings without restarting again. Leaving may forfeit a run or match; rejoining opens the entry place. Save to apply on the next launch.">
                    <ui:ToggleSwitch IsChecked="{Binding AutoLeaveBadChimeRegion, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="Save match region history" Description="Persists every evaluated join to Cache/CompetitiveRegionHistory.json for later analysis.">
                    <ui:ToggleSwitch IsChecked="{Binding LogCompetitiveSessions, Mode=TwoWay}" />
                </controls:OptionControl>

            </StackPanel>
        </ui:CardExpander>

        <!-- ============ NETWORK DIAGNOSTICS (RobloxRouteLab) ============ -->
        <ui:CardExpander Margin="0,8,0,0" IsExpanded="True">
            <ui:CardExpander.Header>
                <TextBlock FontSize="14" Text="Network Diagnostics" FontWeight="SemiBold" />
            </ui:CardExpander.Header>

            <StackPanel Margin="0,8,0,0">
                <controls:OptionControl Header="Live network monitor" Description="On every join: captures the live UDMUX endpoint, resolves region, records WARP state and appends to JSONL history (Logs/CompetitiveSessions)."> 
                    <ui:ToggleSwitch IsChecked="{Binding NetworkMonitorEnabled, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="Cloudflare WARP" Description="Connect or disconnect WARP manually. Network comparison chooses a route during setup; this toggle remains available afterward. WARP affects all Internet traffic on this computer.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding WarpStatus}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ui:ToggleSwitch IsEnabled="{Binding WarpCanControl}" IsChecked="{Binding WarpConnected, Mode=TwoWay}" />
                    </StackPanel>
                </controls:OptionControl>
                <TextBlock Margin="0,8,0,8" TextWrapping="Wrap" Text="Network features are set from installation and follow-up tests. Unavailable diagnostics are disabled until a later test succeeds. Disconnect other VPNs or proxies before comparing routes for an accurate baseline and location estimates." />

                <controls:OptionControl Header="Reset Network" Description="Clear network session logs, traceroutes, region history and learned preferences, then rerun normal-versus-WARP testing.">
                    <ui:Button Content="Reset Network" Padding="12,6" HorizontalAlignment="Left" Command="{Binding ResetNetworkCommand}" />
                </controls:OptionControl>
            </StackPanel>
        </ui:CardExpander>

        <!-- ============ PERFORMANCE ============ -->
        <ui:CardExpander Margin="0,8,0,0" IsExpanded="True">
            <ui:CardExpander.Header>
                <TextBlock FontSize="14" Text="Performance" FontWeight="SemiBold" />
            </ui:CardExpander.Header>

            <StackPanel Margin="0,8,0,0">
                <controls:OptionControl Header="Process Priority" Description="Applied immediately after launch and re-verified ~3s later. High is the recommended competitive setting; RealTime can interfere with Windows scheduling/audio/input." >
                    <StackPanel>
                        <ComboBox
                            Width="200"
                            Padding="10,5"
                            ItemsSource="{Binding PriorityOptions, Mode=OneTime}"
                            SelectedItem="{Binding SelectedCompetitivePriority, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumNameConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="12"
                            Foreground="Orange"
                            Visibility="{Binding ShowRealtimeWarning, Converter={StaticResource BooleanToVisibilityConverter}}"
                            TextWrapping="Wrap"
                            MaxWidth="380"
                            Text="⚠ RealTime priority: aggressive. Can starve audio, storage and input processing. High is usually enough." />
                    </StackPanel>
                </controls:OptionControl>

                <controls:OptionControl Header="Disable execution-speed power throttling" Description="Requests performance-oriented (HighQoS-style) process power state on RobloxPlayerBeta only. Separate from CPU priority; both coexist." >
                    <ui:ToggleSwitch IsChecked="{Binding DisablePowerThrottling, Mode=TwoWay}" />
                </controls:OptionControl>

                <controls:OptionControl Header="Reapply after launch" Description="Bounded checks after startup and at 20 / 60 seconds recover priority or power settings changed during launch.">
                    <StackPanel Orientation="Horizontal">
                        <ui:ToggleSwitch IsChecked="{Binding ReapplyPerformanceSettings, Mode=TwoWay}" />
                        <TextBlock Margin="16,0,4,0" VerticalAlignment="Center" Text="Delay (ms):" />
                        <TextBox Width="70" Padding="4,3" VerticalAlignment="Center" Text="{Binding ReapplyDelayMs, Mode=TwoWay}" />
                    </StackPanel>
                </controls:OptionControl>

                <controls:OptionControl Header="Match monitor refresh rate" Description="Detects the highest supported refresh rate at your active monitors' current resolution on each launch. Applies in both Competitive and Balanced.">
                    <ui:ToggleSwitch IsChecked="{Binding MatchMonitorRefresh, Mode=TwoWay}" />
                </controls:OptionControl>
                <controls:OptionControl Header="FPS Limit" Description="Roblox's real FramerateCap. Turn off monitor matching to enter a manual limit." >
                    <StackPanel>
                        <TextBlock Text="{Binding FpsStatus}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding ManualFpsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ComboBox Width="200" Padding="8,5" ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding SelectedFpsPreset, Mode=TwoWay}" />
                        <TextBlock Margin="16,0,4,0" VerticalAlignment="Center" Text="Custom:" />
                        <TextBox Width="70" Padding="4,3" VerticalAlignment="Center" Text="{Binding CustomFpsCapText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </controls:OptionControl>

                <controls:OptionControl Header="Graphics quality" Description="Competitive locks quality at 3 by making GlobalBasicSettings read-only while Roblox runs; other in-game settings cannot persist until exit. Balanced allows a custom lower-quality preset." >
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding ManualPerformanceControls}">
                        <ui:ToggleSwitch IsChecked="{Binding LowGraphicsPreset, Mode=TwoWay}" />
                        <TextBlock Margin="16,0,4,0" VerticalAlignment="Center" Text="Quality level (0-21):" />
                        <TextBox Width="50" Padding="4,3" VerticalAlignment="Center" Text="{Binding GraphicsQualityLevel, Mode=TwoWay}" />
                    </StackPanel>
                </controls:OptionControl>

                <!-- Rendering layer -->
                <ui:CardExpander Margin="0,8,0,0" IsExpanded="True">
                    <ui:CardExpander.Header>
                        <TextBlock FontSize="13" Text="Competitive Rendering Tweaks (FastFlag layer - best effort)" FontWeight="SemiBold" />
                    </ui:CardExpander.Header>

                    <StackPanel Margin="0,8,0,0" IsEnabled="{Binding ManualPerformanceControls}">
                        <controls:OptionControl Header="MSAA 1x" Description="~ FastFlag FIntDebugForceMSAASamples. Effectiveness depends on the current Roblox allowlist." >
                            <ui:ToggleSwitch IsChecked="{Binding MSAA1x, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="Remove grass" Description="~ FastFlag FRM grass distances set to 0.">
                            <ui:ToggleSwitch IsChecked="{Binding DisableGrass, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="Aggressive low-poly meshes" Description="~ FastFlag CSG LOD switching distances. Optional - can reduce visual detail." >
                            <ui:ToggleSwitch IsChecked="{Binding LowPolyMeshes, Mode=TwoWay}" />
                        </controls:OptionControl>

                        <controls:OptionControl Header="Renderer" Description="Automatic lets Roblox decide (recommended). Forcing D3D11/Vulkan is best-effort - the flags may no longer be honored." >
                            <ComboBox Width="200" Padding="8,5" ItemsSource="{Binding RendererOptions}" SelectedItem="{Binding SelectedRenderer, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumNameConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </controls:OptionControl>
                    </StackPanel>
                </ui:CardExpander>
            </StackPanel>
        </ui:CardExpander>

        <!-- ============ RECENT MATCHES + RUN COMPARISON ============ -->
        <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
            <ui:CardExpander.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" FontSize="14" Text="Recent Matches &amp; Run Comparison" FontWeight="SemiBold" />
                    <ui:Button Grid.Column="1" Content="Refresh" Padding="12,6" Command="{Binding RefreshHistoryCommand}" />
                </Grid>
            </ui:CardExpander.Header>

            <StackPanel Margin="0,8,0,0">
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Last 50 matches from the JSONL history (3 days). Read-only view - full data lives in Logs/CompetitiveSessions." />
                <TextBlock Text="{Binding HistoryStatus}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <ListView ItemsSource="{Binding RecentMatches}" Height="240" BorderThickness="1">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Time" Width="55" DisplayMemberBinding="{Binding Time}" />
                            <GridViewColumn Header="Region" Width="170" DisplayMemberBinding="{Binding Region}" />
                            <GridViewColumn Header="Quality" Width="80" DisplayMemberBinding="{Binding Quality}" />
                            <GridViewColumn Header="Reserved" Width="65" DisplayMemberBinding="{Binding Reserved}" />
                            <GridViewColumn Header="WARP" Width="55" DisplayMemberBinding="{Binding Warp}" />
                            <GridViewColumn Header="ICMP" Width="70" DisplayMemberBinding="{Binding Icmp}" />
                            <GridViewColumn Header="Place" Width="110" DisplayMemberBinding="{Binding Place}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Direct vs WARP comparison, grouped by Run Label -->
                <TextBlock FontSize="13" FontWeight="SemiBold" Margin="0,12,0,4" Text="Run label comparison (observed distribution)" />

                <ListView ItemsSource="{Binding RunSummaries}" Height="160" BorderThickness="1">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Run Label" Width="120" DisplayMemberBinding="{Binding Label}" />
                            <GridViewColumn Header="Matches" Width="65" DisplayMemberBinding="{Binding Matches}" />
                            <GridViewColumn Header="Ideal" Width="55" DisplayMemberBinding="{Binding IdealCount}" />
                            <GridViewColumn Header="Good" Width="55" DisplayMemberBinding="{Binding GoodCount}" />
                            <GridViewColumn Header="Accept." Width="60" DisplayMemberBinding="{Binding AcceptableCount}" />
                            <GridViewColumn Header="Poor/Bad" Width="70" DisplayMemberBinding="{Binding PoorBadCount}" />
                            <GridViewColumn Header="Unknown" Width="65" DisplayMemberBinding="{Binding UnknownCount}" />
                            <GridViewColumn Header="Avg ICMP (ms)" Width="90" DisplayMemberBinding="{Binding AvgIcmpMs, StringFormat={}{0:0.#}}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Always observational: 'observed distribution', not 'WARP causes East servers'. 10+ matches for signal, 30+ preferred. Keep time of day and matchmaking settings similar between runs." />
            </StackPanel>
        </ui:CardExpander>

        <!-- ============ ADVANCED ============ -->
        <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
            <ui:CardExpander.Header>
                <TextBlock FontSize="14" Text="Advanced (unsafe-ish)" FontWeight="SemiBold" />
            </ui:CardExpander.Header>

            <StackPanel Margin="0,8,0,0">
                <controls:OptionControl Header="CPU Affinity" Description="Default is Automatic / Windows-managed - Windows knows your P/E cores, CCDs and processor groups better than a bootstrapper does. Custom mask only covers processor group 0 on >64 CPU systems." >
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="180" Padding="8,5" ItemsSource="{Binding AffinityModes}" SelectedItem="{Binding SelectedAffinityMode, Mode=TwoWay}" />
                        <TextBox
                            Width="120" Margin="12,0,0,0"
                            Padding="4,3"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            Text="{Binding CpuAffinityMaskText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </controls:OptionControl>

                <ui:InfoBar Severity="Warning" IsOpen="True" Margin="0,8,0,0">
                    <TextBlock FontSize="12" TextWrapping="Wrap" Text="Advanced notes: no global registry tweaks are applied by default (no TCP/Nagle/MTU/DNS changes). Power plan switching and a renderer benchmark are planned as opt-in features. Everything here is reversible - Default Roblox preset reverts Competitive Mode entirely." />
                </ui:InfoBar>
            </StackPanel>
        </ui:CardExpander>

        <!-- ============ ROBLOX GLOBAL SETTINGS (merged from old Roblox Settings page) ============ -->
        <Separator Margin="0,16,0,8" />
        <TextBlock FontSize="20" FontWeight="Bold" Text="Roblox Global Settings" Margin="0,0,0,4" />
        <TextBlock
            FontSize="13"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Margin="0,0,0,8"
            Text="Direct edits to Roblox's GlobalBasicSettings file. Section disables itself until the settings file exists (launch Roblox once)." />

        <StackPanel DataContext="{Binding Gbs}" IsEnabled="{Binding DataContext.GBSEnabled, RelativeSource={RelativeSource AncestorType=ui:UiPage}}">
            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:CardAction Grid.Column="0" Margin="0,0,4,0" Command="{Binding ImportCommand}" Icon="FolderAdd24">
                    <TextBlock FontSize="14" Text="Import Settings" />
                </ui:CardAction>
                <ui:CardAction Grid.Column="1" Margin="4,0,4,0" Command="{Binding OpenRobloxFolderCommand}" Icon="Folder24">
                    <TextBlock FontSize="14" Text="Open Folder" />
                </ui:CardAction>
                <ui:CardAction Grid.Column="2" Margin="4,0,0,0" Command="{Binding ExportCommand}" Icon="Save24">
                    <TextBlock FontSize="14" Text="Export Settings" />
                </ui:CardAction>
            </Grid>

            <controls:OptionControl Description="{x:Static resources:Strings.Menu_GBSEditor_ReadOnly_Description}" Header="{x:Static resources:Strings.Menu_GBSEditor_ReadOnly_Title}">
                <ui:ToggleSwitch Margin="5,0,0,0" IsChecked="{Binding ReadOnly}" />
            </controls:OptionControl>

            <StackPanel>
                <Separator Margin="0,8" />
                <TextBlock FontSize="20" FontWeight="Bold" Text="Graphics Settings" Margin="0,0,0,8" />
                <UniformGrid Columns="4">
                    <controls:SquareCard Header="Framerate Limit" Description="Use the FPS Limit controls above when performance mode is enabled.">
                        <ui:TextBox IsEnabled="{Binding DataContext.ManualFpsEnabled, RelativeSource={RelativeSource AncestorType=ui:UiPage}}" Text="{Binding FramerateCap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="ValidateUInt32" />
                    </controls:SquareCard>

                    <controls:SquareCard Header="Start Quality" Description="Competitive starts at quality 3. Adjust Balanced quality above.">
                        <TextBlock Text="3 in Competitive" />
                    </controls:SquareCard>

                    <controls:SquareCard Header="Fullscreen" Description="Start Roblox in fullscreen mode.">
                        <ui:ToggleSwitch IsChecked="{Binding Fullscreen, Mode=TwoWay}" />
                    </controls:SquareCard>

                    <controls:SquareCard Header="Max Quality" Description="Enables higher MSAA levels.">
                        <ui:ToggleSwitch IsChecked="{Binding MaxQualityEnabled, Mode=TwoWay}" />
                    </controls:SquareCard>

                    <controls:SquareCard Header="Vignette" Description="Toggle the screen vignette effect.">
                        <ui:ToggleSwitch IsChecked="{Binding VignetteEnabled, Mode=TwoWay}" />
                    </controls:SquareCard>
                </UniformGrid>

                <Separator Margin="0,8" />
                <TextBlock FontSize="20" FontWeight="Bold" Text="Audio Settings" Margin="0,0,0,8" />
                <UniformGrid Columns="4">
                    <controls:SquareCard Header="Master Volume" Description="Global volume level.">
                        <Slider Minimum="0" Maximum="1" TickFrequency="0.1" Value="{Binding MasterVolume}" AutoToolTipPlacement="TopLeft" />
                    </controls:SquareCard>

                    <controls:SquareCard Header="Studio Volume" Description="Volume for Roblox Studio.">
                        <Slider Minimum="0" Maximum="1" TickFrequency="0.1" Value="{Binding MasterVolumeStudio}" AutoToolTipPlacement="TopLeft" />
                    </controls:SquareCard>

                    <controls:SquareCard Header="Party Volume" Description="Volume for party voice mode.">
                        <Slider Minimum="0" Maximum="1" TickFrequency="0.1" Value="{Binding PartyVoiceVolume}" AutoToolTipPlacement="TopLeft" />
                    </controls:SquareCard>
                </UniformGrid>

                <Separator Margin="0,8" />
                <TextBlock FontSize="20" FontWeight="Bold" Text="Input Settings" Margin="0,0,0,8" />
                <UniformGrid Columns="4">
                    <controls:SquareCard Header="Sensitivity" Description="Global camera sensitivity.">
                        <ui:TextBox Text="{Binding MouseSensitivity}" PreviewTextInput="ValidateFloat" />
                    </controls:SquareCard>

                    <controls:SquareCard Header="ShiftLock" Description="Enable shiftlock Automatically.">
                        <ui:ToggleSwitch IsChecked="{Binding ShiftLock,  Mode=TwoWay}" />
                    </controls:SquareCard>

                    <controls:SquareCard Header="1st Person Sensitivity" Description="X and Y sensitivity for first person.">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="X:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBox Grid.Column="1" Margin="0,0,8,0" ClearButtonEnabled="False" Text="{Binding MouseSensitivityFirstPersonX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="ValidateFloat" />
                            <TextBlock Grid.Column="2" Text="Y:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBox Grid.Column="3" ClearButtonEnabled="False" Text="{Binding MouseSensitivityFirstPersonY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="ValidateFloat" />
                        </Grid>
                    </controls:SquareCard>

                    <controls:SquareCard Header="3rd Person Sensitivity" Description="X and Y sensitivity for third person.">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="X:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBox Grid.Column="1" Margin="0,0,8,0" ClearButtonEnabled="False" Text="{Binding MouseSensitivityThirdPersonX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="ValidateFloat" />
                            <TextBlock Grid.Column="2" Text="Y:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:TextBox Grid.Column="3" ClearButtonEnabled="False" Text="{Binding MouseSensitivityThirdPersonY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="ValidateFloat" />
                        </Grid>
                    </controls:SquareCard>

                    <controls:SquareCard Header="Invert Y" Description="Invert camera Y axis.">
                        <ui:ToggleSwitch IsChecked="{Binding CameraYInverted}" />
                    </controls:SquareCard>

                    <controls:SquareCard Header="Haptic Strength" Description="Controller vibration strength.">
                        <Slider Minimum="0" Maximum="1" TickFrequency="0.1" Value="{Binding HapticStrength}" AutoToolTipPlacement="TopLeft" />
                    </controls:SquareCard>
                </UniformGrid>

                <Separator Margin="0,8" />
                <TextBlock FontSize="20" FontWeight="Bold" Text="Accessibility &amp; Misc" Margin="0,0,0,8" />
                <UniformGrid Columns="4">
                    <controls:SquareCard Header="UI Transparency" Description="Adjust transparency of UI elements.">
                        <ui:TextBox Text="{Binding UITransparency}" PreviewTextInput="ValidateFloat" />
                    </controls:SquareCard>

                    <controls:SquareCard Header="Text Size" Description="Preferred display text size.">
                        <ComboBox ItemsSource="{Binding FontSizes}" 
                                  SelectedValuePath="Key" 
                                  SelectedValue="{Binding SelectedFontSize}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Key}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:SquareCard>

                    <controls:SquareCard Header="Reduced Motion" Description="Reduces UI animations.">
                        <ui:ToggleSwitch IsChecked="{Binding ReducedMotion}" />
                    </controls:SquareCard>

                    <controls:SquareCard Header="Perf Stats" Description="Show performance overlay.">
                        <ui:ToggleSwitch IsChecked="{Binding PerformanceStatsVisible}" />
                    </controls:SquareCard>

                    <controls:SquareCard Header="VR Mode" Description="Enable Virtual Reality support.">
                        <ui:ToggleSwitch IsChecked="{Binding VREnabled}" />
                    </controls:SquareCard>
                </UniformGrid>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:UiPage>
